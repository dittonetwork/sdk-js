{
	"name": "@ditto-network/core",
	"version": "0.1.0",
	"description": "Core functionality for Ditto Network JS SDK",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"files": ["dist"],
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts",
