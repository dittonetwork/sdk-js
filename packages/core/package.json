		"@cosmjs/stargate": "^0.33.1",
		"@cosmjs/tendermint-rpc": "^0.33.1",
		"viem": "^2.28.0"
	},
	"devDependencies": {
		"tsup": "^8.4.0",
		"typescript": "^5.8.3"
	}
}
